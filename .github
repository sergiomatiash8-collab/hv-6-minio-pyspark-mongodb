name: CI Pipeline

on:
  pull_request:
    branches: [main, develop]
  push:
    branches: [main, develop]

jobs:
  test:
    runs-on: ubuntu-latest
    services:
      # GitHub Actions автоматично підніме Docker для інтеграційних тестів,
      # але Testcontainers у твоєму коді сам керує контейнерами,
      # тому нам просто потрібен доступ до Docker Daemon (він є на ubuntu-latest).
    steps:
      - uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
          cache: 'pip' # Кешування пришвидшить наступні запуски

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          # Якщо у тебе немає окремого requirements-dev.txt, 
          # переконайся, що pytest та інше є в основному файлі
          pip install pytest pytest-cov black flake8 mypy bandit

      - name: Run linters
        run: |
          black --check app/ tests/ || true
          flake8 app/ tests/ || true
          mypy app/ || true

      - name: Run unit tests
        run: |
          pytest tests/unit/ -v --cov=app --cov-report=xml

      - name: Run integration tests
        # Інтеграційні тести з Testcontainers потребують Docker
        run: |
          pytest tests/integration/ -v

      - name: Upload coverage
        uses: codecov/codecov-action@v3
        with:
          file: ./coverage.xml
          fail_ci_if_error: false

  security:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Run security scan (Bandit)
        run: |
          pip install bandit
          bandit -r app/ -f json -o bandit-report.json || true

      - name: Upload security report
        uses: actions/upload-artifact@v3
        with:
          name: security-report
          path: bandit-report.json

  build:
    runs-on: ubuntu-latest
    needs: [test, security]
    steps:
      - uses: actions/checkout@v3

      - name: Build Docker image
        run: |
          docker build -t etl-pipeline:${{ github.sha }} .

      - name: Scan Docker image (Trivy)
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: 'etl-pipeline:${{ github.sha }}'
          format: 'table'
          exit-code: '1' # Провалити білд, якщо знайдено критичні вразливості
          severity: 'CRITICAL,HIGH'